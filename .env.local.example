# Copia este archivo a ".env.local" (Next.js lo carga automáticamente).
# Sin estos valores, la app funciona en "modo demo": el login es local
# (no hay cuenta real) y las pantallas que llaman al backend muestran
# datos de ejemplo cuando el backend no puede responder con datos reales.

# URL del backend (src/app.js). En desarrollo local es esta por defecto.
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Supabase (para que el login/registro sea real) ---
# Los encuentras en tu proyecto de Supabase > Project Settings > API.
# OJO: acá va la "anon" key (segura para el navegador), NUNCA la
# "service_role" key que usa el backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
